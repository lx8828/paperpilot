# PaperPilot LLM 配置模板。复制为 .env 并填写：
#   cp .env.example .env

# LLM 服务商 OpenAI 兼容端点
PAPERPILOT_LLM_BASE_URL=https://api.deepseek.com/v1
PAPERPILOT_LLM_API_KEY=sk-你的key
PAPERPILOT_LLM_MODEL=deepseek-chat
PAPERPILOT_LLM_TIMEOUT=120

# 问答并发上限（默认 4）：`/api/ask` 在线程池里最多同时跑几个问答。
# 排队的是线程、不是事件循环（所以一个慢问答不会卡住其他请求）。
# PAPERPILOT_ASK_CONCURRENCY=4

# 上传 PDF 大小上限（默认 200MB；0 = 不限制）。超限直接 413，
# 且在"读进内存之前"就拒掉（省掉一次注定失败的分钟级摄取）。
# PAPERPILOT_MAX_PDF_MB=200
