# PaperPilot LLM 配置模板。复制为 .env 并填写：
#   cp .env.example .env

# LLM 服务商 OpenAI 兼容端点
PAPERPILOT_LLM_BASE_URL=https://api.deepseek.com/v1
PAPERPILOT_LLM_API_KEY=sk-你的key
PAPERPILOT_LLM_MODEL=deepseek-chat
PAPERPILOT_LLM_TIMEOUT=120

# 问答并发上限（默认 4）：`/api/ask` 在线程池里最多同时跑几个问答。
# 排队的是线程、不是事件循环（所以一个慢问答不会卡住其他请求）。
# 必须 >= 1；写 0 / 负数 / 非数字会回退默认 4（0 会让每个问答永久阻塞，没有"关闭闸门"这种用法）。
# PAPERPILOT_ASK_CONCURRENCY=4

# 闸门满时的排队上限（秒，默认 300）：超时返回 503（可重试），而不是让页面无限转圈。
# 0 = 不排队（闸门满就立刻 503，属于更严格的方向）。
# 注意：它**与 MinerU 摄取耗时无关** —— 解析期间问答是直接拒答（不排队）；
# 这里的等待只发生在"前面已有并发上限那么多问答在跑"。单题 p50 约 5s，单人用不排队。
# PAPERPILOT_ASK_WAIT_S=300

# 上传 PDF 大小上限（默认 200MB）。超限直接 413，且在"读进内存之前"就拒掉
# （省掉一次注定失败的分钟级摄取）。只有**显式 0** 才是不限制；
# 负数 / 非数字 / 空串会回退默认 200MB（配置异常不放开权限）。
# PAPERPILOT_MAX_PDF_MB=200
